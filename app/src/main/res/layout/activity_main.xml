<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_idle" android:textStyle="bold" />
    <TextView android:id="@+id/txtIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/txtFeature" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?attr/colorPrimary" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <LinearLayout android:id="@+id/panelWifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receiver_wifi_hint" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/edtManualIp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/manual_ip_hint" android:inputType="text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/refresh" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peerList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
    <LinearLayout android:id="@+id/panelBt" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receiver_bt_hint" />
        <LinearLayout android:id="@+id/btList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBtSettings" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bt_settings" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feat_mic" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMicRecv" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMicStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMicRecord" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_record_mic" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMicRecordStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop_record" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feat_camera" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamRecv" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCamVideoStop" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="@string/btn_start_recording" />
    <ImageView android:id="@+id/imgCamera" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="8dp" android:scaleType="fitCenter" android:background="#22000000" android:contentDescription="@string/feat_camera" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feat_cam_front" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamFrontRecv" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamFrontStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCamFrontRecord" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="@string/btn_start_recording" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feat_storage" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStorageRecv" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStorageStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feat_system" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSysRecv" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSysStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feat_sys_mic" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSysMicRecv" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/btn_open" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSysMicStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_stop" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/volume" />
    <SeekBar android:id="@+id/seekVolume" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDisconnect" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/disconnect" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnInternet" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/internet_connect" />
    <EditText android:id="@+id/edtInternetHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/internet_hint" />
</LinearLayout>
</ScrollView>
<FrameLayout android:id="@+id/cameraOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF000000" android:visibility="gone" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/imgCameraFull" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/cam_live" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:padding="16dp" android:background="#88000000">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamClose" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_close_camera" android:textColor="@android:color/white" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamShot" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/btn_photo" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCamRec" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/btn_video" />
    </LinearLayout>
</FrameLayout>
</FrameLayout>
